# Dependencies
node_modules/

# Build output
packages/*/dist/

# Plugin build artefacts
packages/plugin/main.js
packages/plugin/styles.css

# Server — built plugin distribution files (generated by plugin build)
packages/server/client/main.js
packages/server/client/styles.css
packages/server/client/manifest.json
packages/server/client/build_info.json

# Server runtime config (contains password — never commit)
packages/server/config.js

# Server runtime data
packages/server/data/

# Generated script output / build logs / temp artifacts
*_results.txt
docker-build-output.txt
_tmp_*

# Docker env file (contains password)
.env

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
