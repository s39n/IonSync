{
	"name": "@ionsync/server",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"start": "node --max-old-space-size=4096 --enable-source-maps dist/index.js",
		"dev": "tsx --max-old-space-size=4096 src/index.ts",
		"test": "node --max-old-space-size=4096 --import tsx/esm --test --test-timeout=15000 test/sync.test.ts test/cleanup.test.ts test/seq.test.ts test/syncCursor.test.ts test/security.test.ts test/rename.test.ts test/binaryFrames.test.ts test/folderDelete.test.ts test/verify.test.ts test/attribution.test.ts test/offlineDeletes.test.ts test/conflicts.test.ts",
		"totp:reset": "tsx scripts/totp-reset.ts"
	},
	"dependencies": {
		"@ionsync/protocol": "*",
		"archiver": "^7.0.1",
		"better-sqlite3": "^12.10.0",
		"diff-match-patch": "^1.0.5",
		"express": "^4.19.2",
		"uuid": "^9.0.1",
		"ws": "^8.17.1"
	},
	"devDependencies": {
		"@types/archiver": "^6.0.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/diff-match-patch": "^1.0.36",
		"@types/express": "^4.17.21",
		"@types/node": "^20.14.2",
		"@types/uuid": "^9.0.8",
		"@types/ws": "^8.5.10",
		"tsx": "^4.15.4",
		"typescript": "^5.4.5"
	}
}