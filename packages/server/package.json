{
	"name": "@ionsync/server",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"start": "node --enable-source-maps dist/index.js",
		"dev": "tsx src/index.ts",
		"test": "node --import tsx/esm --test --test-timeout=15000 test/sync.test.ts test/cleanup.test.ts"
	},
	"dependencies": {
		"@ionsync/protocol": "*",
		"better-sqlite3": "^9.6.0",
		"express": "^4.19.2",
		"uuid": "^9.0.1",
		"ws": "^8.17.1"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.10",
		"@types/express": "^4.17.21",
		"@types/node": "^20.14.2",
		"@types/uuid": "^9.0.8",
		"@types/ws": "^8.5.10",
		"tsx": "^4.15.4",
		"typescript": "^5.4.5"
	}
}