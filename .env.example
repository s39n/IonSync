# Copy to .env and fill in before running docker compose up
IONSYNC_PASSWORD=change-me
# IONSYNC_PORT=3000

# ── LLM API (optional; see packages/api/README.md) ──
# Setting a token turns the API on. Use a long random value (24+ characters).
# IONSYNC_API_TOKEN=
# IONSYNC_API_READ_TOKEN=
# IONSYNC_E2EE_PASSWORD=
# IONSYNC_API_PORT=3002
# IONSYNC_API_TRUST_PROXY=1
# IONSYNC_API_TZ=America/Los_Angeles
